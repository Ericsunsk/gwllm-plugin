{
  "name": "gwllm-plugin",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run validate && npm test",
    "index": "node scripts/build-index.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.93.0"
  },
  "engines": {
    "node": "22.23.2"
  }
}
